PORT=5000
SHOPIFY_STORE_DOMAIN=dyva-development.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=replace-with-shopify-client-id
SHOPIFY_CLIENT_SECRET=replace-with-shopify-client-secret
SHOPIFY_ADMIN_TOKEN=replace-with-server-only-admin-token
SHOPIFY_STOREFRONT_TOKEN=replace-with-storefront-token
# Optional Shopify search filter, for example: vendor:YourBrand or product_type:Skincare
SHOPIFY_PRODUCT_QUERY=status:active
# Comma-separated Shopify handles that should never be shown in the storefront.
SHOPIFY_EXCLUDED_PRODUCT_HANDLES=
ADMIN_EMAIL=admin@dyva.store
ADMIN_PASSWORD=ChangeThisPassword123!
JWT_SECRET=replace_with_a_long_random_secret

# Required for Shopify cart and hosted checkout mutations.
# Product reads can use the server-side Admin API when this is absent.
